# =============================================================================
# Talpio — Production (.env on VPS)
# cp .env.production.example .env && nano .env
#
# Bu dosya PRODUCTION içindir: tüm sürücüler gerçektir ve CHANGE_ME değerlerinin
# doldurulması zorunludur. NODE_ENV=production iken uygulama, mock sürücü veya
# varsayılan gizli anahtar görürse açılışta durur (apps/backend/src/config/env.schema.ts).
#
# STAGING için: NODE_ENV=staging yapın; ardından *_DRIVER değerlerini mock'a
# çekebilir ve SEED_DEMO_ACCOUNTS=true ile vitrin hesaplarını açabilirsiniz.
# Doğrulama kuralları yalnızca production'da işler.
# =============================================================================

NODE_ENV=production
TZ=Europe/Istanbul
DEFAULT_LOCALE=tr
SUPPORTED_LOCALES=en,tr,de,es,fr,ar
DEFAULT_COUNTRY_CODE=TR
# Yalnızca kullanıcının ülkesi, işletme ayarı ve dili çözülemediğinde kullanılan
# son çare. Tek bir ülkenin parası olmaması bilinçli.
DEFAULT_CURRENCY=USD

# --- Domain ---
API_PUBLIC_URL=https://api.talpio.app
WEB_APP_URL=https://talpio.app
CORS_ORIGINS=https://talpio.app,https://admin.talpio.app
CADDY_EMAIL=destek@talpio.app

API_PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# --- PostgreSQL (docker internal) ---
POSTGRES_USER=talpio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=talpio

# --- Redis (docker internal) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT (openssl rand -base64 48) ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS

# --- Medya (MinIO + Caddy) ---
STORAGE_DRIVER=minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://media.talpio.app
CDN_PUBLIC_URL=https://media.talpio.app
S3_REGION=eu-central-1
S3_BUCKET=talpio
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true

# --- Push (Expo) ---
# Expo Push API kimlik bilgisi istemez; mobil uygulamanın kaydettiği
# ExponentPushToken jetonları doğrudan kullanılır.
PUSH_DRIVER=expo
# İsteğe bağlı; yalnızca Expo hesabında "enhanced push security" açıksa doldurun.
EXPO_ACCESS_TOKEN=

# --- E-posta (Resend) ---
# Kimlik e-postaları (doğrulama, şifre sıfırlama) bu sürücüden geçer.
# Resend'de talpio.app alanını doğrulayın; gönderen o alanın bir adresi olmalı.
# SMTP yedek: MAIL_DRIVER=smtp ve SMTP_* değişkenlerini doldurun.
MAIL_DRIVER=resend
MAIL_FROM="Talpio <no-reply@talpio.app>"
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- SMS (Netgsm) ---
# Telefon doğrulama (OTP) bu sürücüye bağlıdır. Kimlik bilgisi eksikse
# production açılışta durur; çünkü eksik kimlikle gönderim sessizce başarısız
# olur ve kullanıcılar kaydolamaz.
# Twilio kullanacaksanız: SMS_DRIVER=twilio ve TWILIO_* değişkenlerini doldurun.
SMS_DRIVER=netgsm
SMS_SENDER=TALPIO
NETGSM_USER=CHANGE_ME_NETGSM_USER
NETGSM_PASS=CHANGE_ME_NETGSM_PASSWORD
NETGSM_HEADER=TALPIO
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Ödeme ---
# İlk sürümde platform üzerinden tahsilat yapılmıyor: `disabled` her ödeme
# denemesini açıkça reddeder. `mock` KULLANMAYIN; o, para hareketi olmadan
# siparişi ödenmiş sayar ve production şeması tarafından zaten reddedilir.
PAYMENT_DRIVER=disabled
#
# Tahsilata geçerken: PAYMENT_DRIVER=iyzico yapın, aşağıdaki anahtarları
# doldurun ve kart toplama / 3DS akışını tamamlayın. PAYMENT_DRIVER=paytr
# henüz desteklenmiyor; adaptörü yazılmadı.
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://api.iyzipay.com
# Sağlayıcı webhook imzasını doğrular (openssl rand -base64 32).
# PAYMENT_WEBHOOK_SECRET=
# iyzico yalnızca lira ile mutabakat yapar; ilan fiyatlarıyla ilgisi yoktur.
# PAYMENT_CURRENCY=TRY

# --- AI ---
# Agent yüzeyi kapalı olsa da production mock sürücüyü kabul etmez.
AI_DRIVER=openai
AI_OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
AI_DEFAULT_MODEL=gpt-4o-mini

# --- Next.js build args (docker compose build) ---
# Bunlar derleme aninda imaja gomulur; degistirince yeniden build gerekir.
# NEXT_PUBLIC_SITE_URL ayrica tanimlanmaz, yukaridaki WEB_APP_URL kullanilir.
NEXT_PUBLIC_API_URL=https://api.talpio.app/api/v1
NEXT_PUBLIC_APP_NAME=Talpio
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# --- Seed ---
# production=false ZORUNLU; true ise uygulama açılışta durur.
SEED_DEMO_ACCOUNTS=false
DEMO_PASSWORD=
# Yönetici hesabı parolası; en az 12 karakter.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

REALTIME_ENABLED=true
FEED_CACHE_TTL_SECONDS=45
# Demo hikâyeleri yalnızca vitrin hesapları varken anlamlı.
DEMO_STORY_REFRESH_ENABLED=false
