# =============================================================================
# Talpio — Production / Staging (.env on VPS)
# cp .env.production.example .env && nano .env
# =============================================================================

NODE_ENV=staging
TZ=Europe/Istanbul
DEFAULT_LOCALE=tr
SUPPORTED_LOCALES=en,tr,de,es,fr,ar
DEFAULT_COUNTRY_CODE=TR
DEFAULT_CURRENCY=TRY

# --- Domain ---
API_PUBLIC_URL=https://api.talpio.app
WEB_APP_URL=https://talpio.app
CORS_ORIGINS=https://talpio.app,https://admin.talpio.app
CADDY_EMAIL=destek@talpio.app

API_PORT=3000
API_PREFIX=api/v1
LOG_LEVEL=info

# --- PostgreSQL (docker internal) ---
POSTGRES_USER=talpio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=talpio

# --- Redis (docker internal) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT (openssl rand -base64 48) ---
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS

# --- Medya (MinIO + Caddy) ---
STORAGE_DRIVER=minio
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://media.talpio.app
CDN_PUBLIC_URL=https://media.talpio.app
S3_REGION=eu-central-1
S3_BUCKET=talpio
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_FORCE_PATH_STYLE=true

# --- Bildirim (staging: mock OK; production: gerçek sağlayıcı zorunlu) ---
PUSH_DRIVER=mock
MAIL_DRIVER=mock
SMS_DRIVER=mock
MAIL_FROM="Talpio <destek@talpio.app>"

# --- Ödeme / AI (staging: mock) ---
PAYMENT_DRIVER=mock
AI_DRIVER=mock

# --- Next.js build args (docker compose build) ---
NEXT_PUBLIC_API_URL=https://api.talpio.app/api/v1
NEXT_PUBLIC_APP_NAME=Talpio
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# --- Seed ---
# staging=true → demo hesaplar; production=false ZORUNLU
SEED_DEMO_ACCOUNTS=true
DEMO_PASSWORD=Demo1234!

REALTIME_ENABLED=true
FEED_CACHE_TTL_SECONDS=45
# Lansman öncesi demo hikâyeleri worker ile otomatik yeniler; lansman sonrası false yapın
DEMO_STORY_REFRESH_ENABLED=true
DEMO_STORY_REFRESH_INTERVAL_MS=43200000
