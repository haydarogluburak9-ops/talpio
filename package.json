{
  "name": "ustapilot",
  "version": "0.1.0",
  "private": true,
  "description": "UstaPilot - hizmet pazaryeri platformu (monorepo)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/backend",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:admin",
    "dev:backend": "npm run start:dev --workspace @ustapilot/backend",
    "dev:admin": "npm run dev --workspace @ustapilot/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:migrate": "npm run db:migrate --workspace @ustapilot/backend",
    "db:seed": "npm run db:seed --workspace @ustapilot/backend",
    "db:studio": "npm run db:studio --workspace @ustapilot/backend",
    "docker:up": "docker compose up -d",
    "docker:up:full": "docker compose --profile full up -d --build",
    "docker:down": "docker compose --profile full down",
    "docker:logs": "docker compose --profile full logs -f"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.2"
    }
  }
}
