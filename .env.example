# =============================================================================
# Talpio — Ortam Değişkenleri Şablonu
# Bu dosyayı `.env` olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# `.env` dosyası asla sürüm kontrolüne eklenmez.
# =============================================================================

# -----------------------------------------------------------------------------
# Genel
# -----------------------------------------------------------------------------
NODE_ENV=development
TZ=UTC
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,tr,de,es,fr,ar
DEFAULT_COUNTRY_CODE=TR
DEFAULT_CURRENCY=TRY

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
API_PORT=3000
API_PREFIX=api/v1
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=debug
# Virgülle ayrılmış izinli origin listesi. Web 3002, yönetim paneli 3001
# portunda çalışır; liste hem CORS'u hem çerezli isteklerin kaynak kontrolünü
# belirlediği için ikisi de bulunmalıdır.
CORS_ORIGINS=http://localhost:3002,http://localhost:3001,http://localhost:8080

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=talpio
POSTGRES_PASSWORD=talpio_dev_password
POSTGRES_DB=talpio
# Host portu bilinçli olarak varsayılan 5432 değildir; aynı makinedeki diğer
# projelerin PostgreSQL kapsayıcılarıyla çakışmaması için ayrılmıştır.
POSTGRES_PORT=5442
# Uygulama içinden bağlantı (Docker içinde host: postgres, yerelde: localhost)
DATABASE_URL=postgresql://talpio:talpio_dev_password@localhost:5442/talpio?schema=public
# Production read replica (opsiyonel)
# DATABASE_READ_URL=postgresql://talpio:pass@replica-host:5432/talpio?schema=public

# CDN — CloudFront / Cloudflare medya dağıtımı (opsiyonel)
# CDN_PUBLIC_URL=https://cdn.talpio.com

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT / Kimlik
# -----------------------------------------------------------------------------
# Üretimde mutlaka değiştirin: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Nesne deposu (yerelde MinIO, üretimde S3 uyumlu servis)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9010
S3_PUBLIC_URL=http://localhost:9010
S3_REGION=eu-central-1
S3_BUCKET=talpio
S3_ACCESS_KEY=talpio
S3_SECRET_KEY=talpio_dev_password
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MAX_UPLOAD_SIZE_MB=10
MAX_JOB_MEDIA_COUNT=10
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/heic
ALLOWED_DOCUMENT_MIME=application/pdf,image/jpeg,image/png

# -----------------------------------------------------------------------------
# Bildirim sağlayıcıları
# -----------------------------------------------------------------------------
# mock | expo
# Mobil uygulama Expo push jetonu kaydeder; gönderim Expo Push API üzerinden yapılır.
PUSH_DRIVER=mock
# İsteğe bağlı: Expo hesabında "enhanced push security" açıksa zorunlu olur.
EXPO_ACCESS_TOKEN=

# mock | smtp | resend
MAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM="Talpio <no-reply@talpio.com>"

# mock | netgsm | twilio
SMS_DRIVER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=TALPIO
OTP_LENGTH=6
OTP_TTL_MINUTES=5

# -----------------------------------------------------------------------------
# Ödeme (MVP: mock)
# -----------------------------------------------------------------------------
# mock | iyzico | paytr
PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=TRY
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Varsayılan komisyon: baz puan (1250 = %12,5)
DEFAULT_COMMISSION_BPS=1250
DEFAULT_COMMISSION_FIXED_MINOR=0

# -----------------------------------------------------------------------------
# Harita
# -----------------------------------------------------------------------------
# google | mapbox
MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Admin paneli (Next.js)
# -----------------------------------------------------------------------------
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=Talpio
NEXT_PUBLIC_DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# Seed / demo
# -----------------------------------------------------------------------------
# Sadece development ortamında true olabilir
SEED_DEMO_ACCOUNTS=true
# En az 12 karakter. Yalnızca yerel geliştirme içindir; sunucuda farklı olmalı.
DEMO_PASSWORD=yerel_demo_parolasi
ADMIN_PASSWORD=yerel_admin_parolasi
