# UstaPilot mobil uygulama ortam değişkenleri
#
# UYARI — istemciye gömülen değerler:
# `EXPO_PUBLIC_` ön ekli her değişken derleme sırasında uygulama paketine yazılır
# ve cihazdan okunabilir. Buraya YALNIZCA herkese açık olabilecek değerler konur.
#
# Gizli anahtarlar (JWT gizli anahtarı, ödeme sağlayıcı anahtarları, SMS/e-posta
# sağlayıcı kimlikleri) mobil uygulamada TUTULMAZ; backend'de kalır.
# Derleme zamanı gizli değerleri (EAS kimlik bilgileri, imzalama anahtarları)
# EAS Secrets üzerinden yönetilir, bu dosyaya yazılmaz.

# --- İstemci tarafından görülebilir (public) ---

# API taban adresi. Sürüm ön eki dahil verilir.
# Android emülatörü ana makineye 10.0.2.2 üzerinden ulaşır:
#   http://10.0.2.2:3000/api/v1
# iOS simülatörü ve fiziksel cihazda makinenin LAN adresini kullanın:
#   http://192.168.1.20:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Cihaz dili desteklenmiyorsa kullanılacak varsayılan dil (tr | en)
EXPO_PUBLIC_DEFAULT_LOCALE=tr

# --- Sunucu/derleme tarafı (istemciye gömülmez) ---
# Aşağıdakiler yalnızca EAS Build ortamında tanımlanır, .env dosyasına yazılmaz.
# EXPO_TOKEN=            # EAS CLI kimlik doğrulaması
# EAS_PROJECT_ID=        # app.json içindeki extra.eas.projectId değeri
