{
  "expo": {
    "name": "Talpio",
    "slug": "talpio",
    "scheme": "talpio",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talpio.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Hikâye, gönderi ve iş talebine fotoğraf eklemek için kameraya erişim gerekir.",
        "NSPhotoLibraryUsageDescription": "Hikâye, gönderi ve iş talebine fotoğraf eklemek için galeriye erişim gerekir.",
        "NSLocationWhenInUseUsageDescription": "Size en yakın mağaza ve satıcıları gösterebilmek için konumunuza erişim gerekir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.talpio.app",
      "adaptiveIcon": {
        "backgroundColor": "#021B32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#021B32",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hikâye, gönderi ve iş talebine fotoğraf eklemek için galeriye erişim gerekir.",
          "cameraPermission": "Hikâye, gönderi ve iş talebine fotoğraf eklemek için kameraya erişim gerekir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Size en yakın mağaza ve satıcıları gösterebilmek için konumunuza erişim gerekir."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a3de70ce-10ea-4cd1-a353-c0101408d24e"
      }
    },
    "owner": "burakhaydar"
  }
}
