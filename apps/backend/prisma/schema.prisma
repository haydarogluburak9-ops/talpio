/// 24 saatlik pencere skoru; spam için unique etkileşim eşiği uygulanır.
model TrendingTopic {
  id                  String   @id @default(uuid(7))
  hashtagId           String   @map("hashtag_id")
  windowStart         DateTime @map("window_start")
  score               Int      @default(0)
  uniqueInteractions  Int      @default(0) @map("unique_interactions")
  engagementVelocity  Float    @default(0) @map("engagement_velocity")
  saveCount           Int      @default(0) @map("save_count")
  requestConversions  Int      @default(0) @map("request_conversions")
  regionCityId        String?  @map("region_city_id")
  categoryId          String?  @map("category_id")
  computedAt          DateTime @default(now()) @map("computed_at")

  hashtag    Hashtag          @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  regionCity City?            @relation(fields: [regionCityId], references: [id], onDelete: SetNull)
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([hashtagId, windowStart])
  @@index([windowStart, score])
  @@map("trending_topics")
}
