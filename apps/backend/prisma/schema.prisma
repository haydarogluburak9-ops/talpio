// Talpio veritabanı şeması
//
// Adlandırma kuralı: Prisma tarafında camelCase, PostgreSQL tarafında snake_case.
// Bu ayrım @map/@@map ile sağlanır ve tüm modellerde uygulanır.
//
// Para birimi: tutarlar daima en küçük birimde (TRY için kuruş) tam sayı olarak
// tutulur. Kayan noktalı tip hiçbir parasal alanda kullanılmaz.
//
// Silme: kullanıcı verisi taşıyan modellerde `deletedAt` ile yumuşak silme
// uygulanır; kayıt fiziksel olarak silinmez.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7'de bağlantı adresi şemada tutulmaz:
// CLI için `prisma.config.ts`, çalışma zamanı için sürücü adaptörü kullanılır.
datasource db {
  provider = "postgresql"
}

