# UstaPilot API
#
# Bu dosyayı `.env` olarak kopyalayın. Değerler açılışta Zod ile doğrulanır;
# eksik veya hatalı bir değer varsa süreç istek almadan sonlanır.
#
# Kök dizindeki `.env` altyapı servislerinin (Docker Compose) portlarını da
# içerir. Yalnızca API'yi çalıştıracaksanız bu dosya yeterlidir.

# --- Genel ---
NODE_ENV=development
TZ=UTC
DEFAULT_LOCALE=tr
SUPPORTED_LOCALES=tr,en
DEFAULT_COUNTRY_CODE=TR
DEFAULT_CURRENCY=TRY

# --- API ---
API_PORT=3000
API_PREFIX=api/v1
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=debug
# Virgülle ayrılmış izinli origin listesi: admin (3001) ve web (3002).
# Expo geliştirme istemcisi Origin başlığı göndermez, listeye eklenmesi gerekmez.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- PostgreSQL ---
# Host portu bilinçli olarak 5432 değildir; aynı makinedeki diğer projelerle
# çakışmaması için ayrılmıştır.
DATABASE_URL=postgresql://ustapilot:ustapilot_dev_password@localhost:5442/ustapilot?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_PASSWORD=
REDIS_DB=0

# --- Kimlik doğrulama ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN: openssl rand -base64 48
# "change_me" içeren değerler production ortamında reddedilir.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# --- Hız sınırlama ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Nesne deposu (yerelde MinIO) ---
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9010
S3_PUBLIC_URL=http://localhost:9010
S3_REGION=eu-central-1
S3_BUCKET=ustapilot
S3_ACCESS_KEY=ustapilot
S3_SECRET_KEY=ustapilot_dev_password
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_SIZE_MB=10
MAX_JOB_MEDIA_COUNT=10
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/heic
ALLOWED_DOCUMENT_MIME=application/pdf,image/jpeg,image/png

# --- Bildirim sağlayıcıları ---
# Geliştirmede tümü mock: dış servise istek gidilmez, çıktı log'a yazılır.
PUSH_DRIVER=mock
MAIL_DRIVER=mock
SMS_DRIVER=mock
OTP_LENGTH=6
OTP_TTL_MINUTES=5

# --- Ödeme ---
# Etkin sağlayıcı adaptörünü seçer. production ortamında mock olamaz.
PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=TRY
# Sağlayıcı webhook'larının HMAC-SHA256 imzasını doğrulayan gizli anahtar.
PAYMENT_WEBHOOK_SECRET=change_me_payment_webhook_secret
# Varsayılan komisyon baz puan cinsindendir (1250 = %12,5).
DEFAULT_COMMISSION_BPS=1250
DEFAULT_COMMISSION_FIXED_MINOR=0

# --- Tohum verisi / demo ---
# production ortamında true olamaz; şema bunu reddeder.
SEED_DEMO_ACCOUNTS=true
DEMO_PASSWORD=Demo1234!
