# Talpio web uygulaması
#
# NEXT_PUBLIC_ önekli değişkenler istemci paketine gömülür ve herkes tarafından
# görülebilir. Gizli anahtar bu dosyaya asla yazılmaz.

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Ücretsiz lansman: kapalı tutun. Premium paket + AI agent sonra açılır.
NEXT_PUBLIC_FEATURE_PREMIUM=false
NEXT_PUBLIC_FEATURE_AGENT=false
NEXT_PUBLIC_FEATURE_PAYMENTS=false
